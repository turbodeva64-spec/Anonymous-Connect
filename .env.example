# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Cloud SQL Runtime Environment Variables (Automatically injected by AI Studio)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="REDACTED"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="REDACTED"

# Cryptographic HMAC signing secret for short-lived attachment URLs
SESSION_SECRET="replace-with-64-char-cryptographic-random-secret"
